# Flowy environment variables
# Copy to .env and fill in your values:
#   cp .env.example .env
# Never commit .env — it is gitignored.

# Required
NEXT_PUBLIC_SITE_URL=https://flowy-jade.vercel.app
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flowy
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CRON_SECRET=your-cron-secret
ADMIN_BOOTSTRAP_SECRET=your-bootstrap-secret

# Web Push (optional)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# Vercel Flags (optional)
# FLAGS=your-flags-sdk-key
# FLAGS_SECRET=your-flags-secret
# VERCEL_OIDC_TOKEN=your-oidc-token

# Rate limiting (optional)
RATE_LIMIT_ENABLED=true
# RATE_LIMIT_TRANSACTION_REQUESTS=20
# RATE_LIMIT_TRANSACTION_WINDOW=120000
# RATE_LIMIT_DEFAULT_REQUESTS=150
# RATE_LIMIT_DEFAULT_WINDOW=120000

# AI Assistant (optional)
# Default provider is Google Gemini. Get a key at https://aistudio.google.com/apikey
AI_PROVIDER=google
AI_PROVIDER_API_KEY=your-gemini-key
AI_MODEL=gemini-2.0-flash
AI_MAX_TOKENS=1024
AI_DAILY_MESSAGE_LIMIT=20
