# Flowy environment variables
# Copy to .env and fill in your values:
#   cp .env.example .env
# Never commit .env — it is gitignored.

# ── Required ────────────────────────────────────────────────────────────────

# Public site URL used to resolve canonical and social metadata
NEXT_PUBLIC_SITE_URL=https://flowy-jade.vercel.app

# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flowy

# Supabase project URL (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anonymous (publishable) key — safe for the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key — SERVER ONLY, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Protects cron endpoints (e.g. /api/cron/alerts) — must match what your
# scheduler (Vercel cron in vercel.json) sends
CRON_SECRET=your-cron-secret

# Secret for the first-admin bootstrap (/api/admin/bootstrap). Lets the owner
# claim the admin role in-app while NO admin exists (e.g. a fresh database).
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Once the first admin exists the bootstrap is disabled forever — use it to
# promote yourself, then remove or keep it as a recovery path.
ADMIN_BOOTSTRAP_SECRET=your-bootstrap-secret

# ── Web Push (optional — required for push notifications) ───────────────────
# Generate a keypair once with: npx web-push generate-vapid-keys

NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# Contact used when subscribing (defaults to mailto:no-reply@flowy.app)
VAPID_SUBJECT=mailto:you@example.com

# ── Vercel Flags (optional) ────────────────────────────────────────────────
# Feature flags managed from the Vercel Flags dashboard (`vercel flags` CLI).
# After linking the project (`vercel link`), run `vercel env pull` to write
# these locally:
#   FLAGS — SDK key used by local dev to evaluate flags against Vercel Flags
#     (create per environment with `vercel flags sdk-keys add --type server
#     --environment <env>`)
#   FLAGS_SECRET — 32 random bytes, base64url-encoded, distinct per
#     environment (mark Preview/Production as Sensitive); used for precompute
#     and the Flags Explorer
#   VERCEL_OIDC_TOKEN — auto-authenticates flag evaluation inside Vercel
#     deployments (new projects; pulled locally for completeness)

# ── Rate limiting (optional) ────────────────────────────────────────────────

# Set to "false" to disable API rate limiting (enabled by default)
RATE_LIMIT_ENABLED=true

# Per-route overrides (requests per window in ms); defaults exist for every
# route, e.g.:
# RATE_LIMIT_TRANSACTION_REQUESTS=20
# RATE_LIMIT_TRANSACTION_WINDOW=120000
# RATE_LIMIT_DEFAULT_REQUESTS=150
# RATE_LIMIT_DEFAULT_WINDOW=120000
