# PostgreSQL connection string used by Prisma (required)
DATABASE_URL="postgresql://user:password@host:5432/flowy?schema=public"

# Supabase project settings (required)
NEXT_PUBLIC_SUPABASE_URL="https://your_project_ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# Optional fallback for the anon key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"

# Protects the cron endpoints, e.g. /api/cron/alerts (required for cron)
CRON_SECRET="generate_a_random_string"

# Set to "false" to disable API rate limiting (defaults to enabled)
# RATE_LIMIT_ENABLED="true"
