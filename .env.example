# Flowy environment variables
# Copy to .env and fill in your values:
#   cp .env.example .env
# Never commit .env — it is gitignored.

# ── Required ────────────────────────────────────────────────────────────────

# Public site URL used to resolve canonical and social metadata
NEXT_PUBLIC_SITE_URL=https://flowy-jade.vercel.app

# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flowy

# Supabase project URL (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anonymous (publishable) key — safe for the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key — SERVER ONLY, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Protects cron endpoints (e.g. /api/cron/alerts) — must match what your
# scheduler (Vercel cron in vercel.json) sends
CRON_SECRET=your-cron-secret

# ── Web Push (optional — required for push notifications) ───────────────────
# Generate a keypair once with: npx web-push generate-vapid-keys

NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# Contact used when subscribing (defaults to mailto:no-reply@flowy.app)
VAPID_SUBJECT=mailto:you@example.com

# ── Rate limiting (optional) ────────────────────────────────────────────────

# Set to "false" to disable API rate limiting (enabled by default)
RATE_LIMIT_ENABLED=true

# Per-route overrides (requests per window in ms); defaults exist for every
# route, e.g.:
# RATE_LIMIT_TRANSACTION_REQUESTS=20
# RATE_LIMIT_TRANSACTION_WINDOW=120000
# RATE_LIMIT_DEFAULT_REQUESTS=150
# RATE_LIMIT_DEFAULT_WINDOW=120000
