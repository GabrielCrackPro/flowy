{
  "buildCommand": "pnpm build",
  "outputDirectory": ".next",
  "devCommand": "pnpm dev",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": "nextjs",
  "regions": ["iad1"],
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "crons": [
    {
      "path": "/api/cron/alerts",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/status",
      "schedule": "0 0 * * *"
    }
  ]
}
