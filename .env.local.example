# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Algunos proyectos usan la variante PUBLISHABLE_KEY en lugar de ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Prisma
DATABASE_URL=postgresql://postgres:password@db-host:5432/postgres

# Cron (protege /api/cron/alerts)
CRON_SECRET=

# Nota: copia este archivo a `.env.local` y añade tus claves reales.
