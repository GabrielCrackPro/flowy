{
  "name": "flowy",
  "version": "0.1.23",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "lint:openapi": "redocly lint public/openapi.json",
    "check:openapi-routes": "node scripts/check-openapi-routes.mjs",
    "check:openapi": "pnpm generate:openapi && git diff --exit-code -- public/openapi.json && pnpm lint:openapi && pnpm check:openapi-routes",
    "generate:changelog": "node scripts/generate-changelog.mjs",
    "check:changelog": "pnpm generate:changelog && git diff --exit-code -- src/lib/changelog/generated.json",
    "prepare": "git config core.hooksPath .githooks || true",
    "prisma": "prisma",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aejkatappaja/phantom-ui": "^1.4.0",
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.5.7",
    "@prisma/client": "^5.13.0",
    "@scalar/nextjs-api-reference": "0.11.13",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2",
    "@tanstack/query-persist-client-core": "^5.101.4",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.42.2",
    "i18next": "^26.3.6",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.26.0",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.83.0",
    "react-i18next": "^17.0.11",
    "recharts": "^2.15.4",
    "shadcn": "^4.14.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@redocly/cli": "^2.46.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jspdf": "^2.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "lint-staged": "^17.3.0",
    "prisma": "^5.13.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.11",
    "typescript": "^5"
  },
  "overrides": {
    "react-is": "^19.2.4"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,mjs,cjs,json,jsonc,css}": "biome check --write"
  }
}
