#!/usr/bin/env sh
set -e

# Pre-commit hook:
# 1. lint-staged applies `biome check --write` (formatting, import
#    organization, and safe lint fixes) to staged files and re-stages them.
#    Any non-fixable lint error aborts the commit.
# 2. Typecheck runs only when the commit touches TypeScript files — docs,
#    config, and JSON-only commits (most CI/docs work) skip the full-project
#    check and commit fast. CI runs `pnpm typecheck` on every PR regardless,
#    so a code change can never bypass it.
#
# To skip these checks for a specific commit (e.g. a docs-only change),
# commit with --no-verify. Note: git runs this hook before the commit
# message exists, so it cannot skip itself based on message content.
pnpm exec lint-staged

if git diff --cached --name-only | grep -qE '\.(ts|tsx|cts|mts)$'; then
  pnpm typecheck
fi
